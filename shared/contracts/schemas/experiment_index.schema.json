{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperimentIndex",
  "type": "object",
  "required": ["schema_version", "generated_at", "datasets", "runs", "leakage_study"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string" },
    "datasets": { "type": "array", "items": { "type": "string" } },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "kind", "dataset", "model_name", "feature_set", "split_strategy", "metrics"],
        "properties": {
          "run_id": { "type": "string" },
          "kind": { "type": "string" },
          "dataset": { "type": "string" },
          "model_name": { "type": "string" },
          "feature_set": { "type": "string" },
          "split_strategy": { "type": "string" },
          "metrics": { "type": "object" },
          "config": { "type": "string" }
        }
      }
    },
    "leakage_study": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "split_strategy", "val_acc"],
        "properties": {
          "run_id": { "type": "string" },
          "model_name": { "type": "string" },
          "split_strategy": { "type": "string" },
          "val_acc": { "type": "number" },
          "test_acc": { "type": "number" },
          "val_test_gap": { "type": "number" },
          "nn_dist_val_to_train": { "type": "number" }
        }
      }
    }
  }
}
