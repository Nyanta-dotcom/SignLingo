# Optional account sync (Supabase). Leave both empty to run the app fully local, with no sign-in.
# Both values are public by design: security comes from Row Level Security (supabase/migrations/0001_init.sql).
# NEVER put the service_role key here or anywhere in this repo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to true only after Google sign-in is enabled in Supabase (Authentication > Providers > Google).
VITE_SUPABASE_GOOGLE=
